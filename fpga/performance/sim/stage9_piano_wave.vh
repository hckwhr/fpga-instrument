// Bright keyboard: 6500*(sin(p)+0.28*sin(2p)+0.12*sin(3p)+0.04*sin(4p)).
// 128 periodic knots with 8-bit interpolation retain smoothness and headroom.
function signed [15:0] piano_point;
    input [6:0] index;
    begin
        case (index)
            7'd0: piano_point = 16'sd0;
            7'd1: piano_point = 16'sd663;
