// SOM30354 + Dock31005. Non-display pins unchanged from accepted stage65.
// HDMI: official tang_mega_138K_pins.cst and Dock31005 connector schematic;
// these same differential pairs were routed and programmed in stage41e.
IO_LOC "sys_clk" V22;
// Accepted LCD connector wiring from stage65, independent of HDMI bank3 pairs.
IO_LOC "lcd_de" L14;
IO_LOC "lcd_vsync" L15;
IO_LOC "lcd_hsync" N20;
IO_LOC "lcd_pclk" L19;
IO_LOC "lcd_bl" P20;
IO_LOC "lcd_b[5]" M20;
