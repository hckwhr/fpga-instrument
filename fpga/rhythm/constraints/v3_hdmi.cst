IO_LOC "lcd_g[4]" N22;
IO_LOC "lcd_g[3]" M22;
IO_LOC "lcd_g[2]" M21;
IO_LOC "lcd_g[1]" L21;
IO_LOC "lcd_g[0]" K18;
IO_LOC "lcd_r[5]" K21;
