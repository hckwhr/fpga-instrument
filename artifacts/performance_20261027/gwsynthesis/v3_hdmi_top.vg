module v3_hdmi_top (
  sys_clk,
  key0_n,
  key1_n,
  key2_n,
  setting_key,
  adc_miso,
  hc05_rx,
  pluck_debug,
  adc_sclk,
  adc_mosi,
  adc_cs0_n,
  adc_cs1_n,
  adc_led,
  hc05_tx,
  ws2812_data,
  audio_bck,
  audio_ws,
  audio_din,
  audio_pa_en_n,
  hdmi_clock_p,
  hdmi_clock_n,
  hdmi_data_p,
  hdmi_data_n,
  hdmi_tx_enable
)
;
input sys_clk;
input key0_n;
input key1_n;
input key2_n;
input setting_key;
input adc_miso;
input hc05_rx;
output pluck_debug;
output adc_sclk;
