);
  OBUF adc_cs1_n_obuf (
    .O(adc_cs1_n),
    .I(adc_cs1_n_d) 
);
  OBUF adc_led_0_obuf (
    .O(adc_led[0]),
    .I(adc_led_d[0]) 
);
  OBUF adc_led_1_obuf (
    .O(adc_led[1]),
    .I(adc_led_d[1]) 
);
  OBUF adc_led_2_obuf (
    .O(adc_led[2]),
    .I(adc_led_d[2]) 
);
  OBUF adc_led_3_obuf (
    .O(adc_led[3]),
    .I(adc_led_d[3]) 
);
  OBUF hc05_tx_obuf (
    .O(hc05_tx),
    .I(hc05_tx_d) 
);
  OBUF ws2812_data_obuf (
