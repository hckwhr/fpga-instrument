  hdmi_pll u_video (
    .sys_clk_d(sys_clk_d),
    .n20_6(n20_6),
    .enable_r(enable_r[1]),
    .pll_lock(pll_lock),
    .serial_clk(serial_clk),
    .pixel_clk(pixel_clk),
    .state(state[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* hdmi_clocks */
