module uart_byte_cdc_0 (
  audio_clk,
  n726_6,
  half_tick_10,
  sys_clk_d,
  n43_6,
  n33_4,
  n6_4,
  owner_song,
  locked,
  n32_9,
  half_tick_12,
  n5551_4,
  legacy_audio_tx,
  sys_release,
  n56_4,
  n56_7,
  request,
  legacy_tx_data,
  ack_sync
)
;
input audio_clk;
input n726_6;
input half_tick_10;
input sys_clk_d;
input n43_6;
input n33_4;
input n6_4;
input owner_song;
