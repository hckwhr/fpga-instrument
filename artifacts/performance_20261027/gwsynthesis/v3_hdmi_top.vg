wire adc_cs1_n_d;
wire adc_mosi_d;
wire adc_sclk_d;
wire audio_din_d;
wire audio_bck_d;
wire audio_ws_d;
wire [3:0] adc_led_d;
wire VCC;
wire GND;
  IBUF sys_clk_ibuf (
    .O(sys_clk_d),
    .I(sys_clk) 
);
  IBUF key0_n_ibuf (
    .O(key0_n_d),
    .I(key0_n) 
);
  IBUF key1_n_ibuf (
    .O(key1_n_d),
    .I(key1_n) 
);
  IBUF key2_n_ibuf (
    .O(key2_n_d),
    .I(key2_n) 
);
  IBUF setting_key_ibuf (
    .O(setting_key_d),
    .I(setting_key) 
);
  IBUF adc_miso_ibuf (
    .O(adc_miso_d),
    .I(adc_miso) 
);
  IBUF hc05_rx_ibuf (
    .O(hc05_rx_d),
    .I(hc05_rx) 
);
  OBUF pluck_debug_obuf (
    .O(pluck_debug),
    .I(pluck_debug_d) 
);
  OBUF adc_sclk_obuf (
    .O(adc_sclk),
    .I(adc_sclk_d) 
);
  OBUF adc_mosi_obuf (
