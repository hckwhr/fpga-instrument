    .I(audio_pa_en_n_d) 
);
  OBUF hdmi_tx_enable_obuf (
    .O(hdmi_tx_enable),
    .I(VCC) 
);
  av_hdmi_top u_instrument (
    .sys_clk_d(sys_clk_d),
    .key0_n_d(key0_n_d),
    .key1_n_d(key1_n_d),
    .key2_n_d(key2_n_d),
    .setting_key_d(setting_key_d),
