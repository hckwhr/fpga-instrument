// SOM30354 + Dock31005. Non-display pins unchanged from accepted stage65.
// HDMI: official tang_mega_138K_pins.cst and Dock31005 connector schematic;
// these same differential pairs were routed and programmed in stage41e.
IO_LOC "sys_clk" V22;
IO_LOC "key0_n" AA13;
IO_LOC "key1_n" AB13;
IO_LOC "key2_n" Y12;
IO_LOC "setting_key" F4;
IO_LOC "adc_sclk" A15;
IO_LOC "adc_miso" B20;
IO_LOC "adc_mosi" B21;
IO_LOC "adc_cs0_n" B17;
IO_LOC "adc_cs1_n" D17;
IO_LOC "hc05_rx" A20;
IO_LOC "hc05_tx" A21;
IO_LOC "ws2812_data" C17;
IO_LOC "pluck_debug" C18;
IO_LOC "adc_led[0]" T18;
IO_LOC "adc_led[1]" R18;
IO_LOC "adc_led[2]" R17;
IO_LOC "adc_led[3]" P16;
IO_LOC "audio_bck" Y17;
IO_LOC "audio_ws" AB17;
IO_LOC "audio_din" AA16;
IO_LOC "audio_pa_en_n" AB16;
IO_LOC "hdmi_data_p[0]" J14,H14;
IO_LOC "hdmi_data_p[1]" J15,H15;
IO_LOC "hdmi_data_p[2]" K17,J17;
IO_LOC "hdmi_clock_p" G15,G16;
IO_LOC "hdmi_tx_enable" K14;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "key0_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "key1_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "key2_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "setting_key" IO_TYPE=LVCMOS15 PULL_MODE=NONE BANK_VCCIO=1.5;
IO_PORT "adc_sclk" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "adc_miso" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_PORT "adc_mosi" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "adc_cs0_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "adc_cs1_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "hc05_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "hc05_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "ws2812_data" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "pluck_debug" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "adc_led[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "adc_led[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "adc_led[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "adc_led[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "audio_bck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "audio_ws" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "audio_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "audio_pa_en_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
// LVCMOS33D + ELVDS_OBUF drives the paired TMDS P/N balls in bank3, 3.3 V.
IO_PORT "hdmi_data_p[0]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "hdmi_data_p[1]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "hdmi_data_p[2]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "hdmi_clock_p" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "hdmi_tx_enable" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
