;
input sys_clk_d;
output pll_lock;
output audio_clk;
output n20_6;
output [2:0] state;
output [1:1] enable_r;
wire pll_rst;
wire [2:0] lpfres;
wire [0:0] icpsel;
wire VCC;
wire GND;
  audio_pll_MOD u_pll (
    .sys_clk_d(sys_clk_d),
    .pll_rst(pll_rst),
    .icpsel(icpsel[0]),
    .lpfres(lpfres[2:0]),
    .pll_lock(pll_lock),
    .audio_clk(audio_clk)
);
  PLL_INIT u_pll_init (
    .sys_clk_d(sys_clk_d),
    .pll_lock(pll_lock),
    .pll_rst(pll_rst),
    .n20_6(n20_6),
    .lpfres(lpfres[2:0]),
    .icpsel(icpsel[0]),
    .state(state[2:0]),
    .enable_r(enable_r[1])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* audio_pll */
module hdmi_pll_MOD (
  sys_clk_d,
  pll_rst,
  icpsel,
  lpfres,
  pll_lock,
  serial_clk,
  pixel_clk
)
;
