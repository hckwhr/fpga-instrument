module hdmi_pll (
  sys_clk_d,
  n20_6,
  enable_r,
  pll_lock,
  serial_clk,
  pixel_clk,
  state
)
;
input sys_clk_d;
input n20_6;
input [1:1] enable_r;
output pll_lock;
output serial_clk;
output pixel_clk;
output [2:0] state;
wire pll_rst;
wire [2:0] lpfres;
wire [1:0] icpsel;
wire VCC;
wire GND;
  hdmi_pll_MOD u_pll (
    .sys_clk_d(sys_clk_d),
    .pll_rst(pll_rst),
    .icpsel(icpsel[1:0]),
    .lpfres(lpfres[2:0]),
    .pll_lock(pll_lock),
    .serial_clk(serial_clk),
    .pixel_clk(pixel_clk)
);
  PLL_INIT_0 u_pll_init (
    .sys_clk_d(sys_clk_d),
    .n20_6(n20_6),
    .pll_lock(pll_lock),
    .enable_r(enable_r[1]),
    .pll_rst(pll_rst),
    .lpfres(lpfres[2:0]),
    .icpsel(icpsel[1:0]),
    .state(state[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* hdmi_pll */
