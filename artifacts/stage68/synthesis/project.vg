module v3_hdmi_top (
  sys_clk,
  key0_n,
  key1_n,
  key2_n,
  setting_key,
  adc_miso,
  hc05_rx,
  pluck_debug,
  adc_sclk,
  adc_mosi,
  adc_cs0_n,
  adc_cs1_n,
  adc_led,
  hc05_tx,
  ws2812_data,
  audio_bck,
  audio_ws,
  audio_din,
  audio_pa_en_n,
  hdmi_clock_p,
  hdmi_clock_n,
  hdmi_data_p,
  hdmi_data_n,
  hdmi_tx_enable
)
;
input sys_clk;
input key0_n;
input key1_n;
input key2_n;
input setting_key;
input adc_miso;
input hc05_rx;
output pluck_debug;
output adc_sclk;
output adc_mosi;
output adc_cs0_n;
output adc_cs1_n;
output [3:0] adc_led;
output hc05_tx;
output ws2812_data;
output audio_bck;
output audio_ws;
output audio_din;
output audio_pa_en_n;
output hdmi_clock_p;
output hdmi_clock_n;
output [2:0] hdmi_data_p;
output [2:0] hdmi_data_n;
output hdmi_tx_enable;
wire sys_clk_d;
wire key0_n_d;
wire key1_n_d;
wire key2_n_d;
wire setting_key_d;
wire adc_miso_d;
wire hc05_rx_d;
wire pluck_debug_d;
wire audio_pa_en_n_d;
wire ws2812_data_d;
wire hc05_tx_d;
wire adc_cs0_n_d;
wire adc_cs1_n_d;
wire adc_mosi_d;
wire adc_sclk_d;
wire audio_din_d;
wire audio_bck_d;
wire audio_ws_d;
wire [3:0] adc_led_d;
wire VCC;
wire GND;
  IBUF sys_clk_ibuf (
    .O(sys_clk_d),
    .I(sys_clk) 
);
  IBUF key0_n_ibuf (
    .O(key0_n_d),
    .I(key0_n) 
);
  IBUF key1_n_ibuf (
    .O(key1_n_d),
    .I(key1_n) 
);
  IBUF key2_n_ibuf (
    .O(key2_n_d),
    .I(key2_n) 
);
  IBUF setting_key_ibuf (
    .O(setting_key_d),
    .I(setting_key) 
);
  IBUF adc_miso_ibuf (
    .O(adc_miso_d),
    .I(adc_miso) 
);
  IBUF hc05_rx_ibuf (
    .O(hc05_rx_d),
    .I(hc05_rx) 
);
  OBUF pluck_debug_obuf (
    .O(pluck_debug),
    .I(pluck_debug_d) 
);
  OBUF adc_sclk_obuf (
    .O(adc_sclk),
    .I(adc_sclk_d) 
);
  OBUF adc_mosi_obuf (
    .O(adc_mosi),
    .I(adc_mosi_d) 
);
  OBUF adc_cs0_n_obuf (
    .O(adc_cs0_n),
    .I(adc_cs0_n_d) 
);
  OBUF adc_cs1_n_obuf (
    .O(adc_cs1_n),
    .I(adc_cs1_n_d) 
);
  OBUF adc_led_0_obuf (
    .O(adc_led[0]),
    .I(adc_led_d[0]) 
);
  OBUF adc_led_1_obuf (
    .O(adc_led[1]),
    .I(adc_led_d[1]) 
);
  OBUF adc_led_2_obuf (
    .O(adc_led[2]),
    .I(adc_led_d[2]) 
);
  OBUF adc_led_3_obuf (
    .O(adc_led[3]),
    .I(adc_led_d[3]) 
);
  OBUF hc05_tx_obuf (
    .O(hc05_tx),
    .I(hc05_tx_d) 
);
  OBUF ws2812_data_obuf (
    .O(ws2812_data),
    .I(ws2812_data_d) 
);
  OBUF audio_bck_obuf (
    .O(audio_bck),
    .I(audio_bck_d) 
);
  OBUF audio_ws_obuf (
    .O(audio_ws),
    .I(audio_ws_d) 
);
  OBUF audio_din_obuf (
    .O(audio_din),
    .I(audio_din_d) 
);
  OBUF audio_pa_en_n_obuf (
    .O(audio_pa_en_n),
    .I(audio_pa_en_n_d) 
);
  OBUF hdmi_tx_enable_obuf (
    .O(hdmi_tx_enable),
    .I(VCC) 
);
  av_hdmi_top u_instrument (
    .sys_clk_d(sys_clk_d),
    .key0_n_d(key0_n_d),
    .key1_n_d(key1_n_d),
    .key2_n_d(key2_n_d),
    .setting_key_d(setting_key_d),
    .hc05_rx_d(hc05_rx_d),
    .adc_miso_d(adc_miso_d),
    .pluck_debug_d(pluck_debug_d),
    .audio_pa_en_n_d(audio_pa_en_n_d),
    .hdmi_clock_p(hdmi_clock_p),
    .hdmi_clock_n(hdmi_clock_n),
    .ws2812_data_d(ws2812_data_d),
    .hc05_tx_d(hc05_tx_d),
    .adc_cs0_n_d(adc_cs0_n_d),
    .adc_cs1_n_d(adc_cs1_n_d),
    .adc_mosi_d(adc_mosi_d),
    .adc_sclk_d(adc_sclk_d),
    .audio_din_d(audio_din_d),
    .audio_bck_d(audio_bck_d),
    .audio_ws_d(audio_ws_d),
    .hdmi_data_p(hdmi_data_p[2:0]),
    .hdmi_data_n(hdmi_data_n[2:0]),
    .adc_led_d(adc_led_d[3:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* v3_hdmi_top */
